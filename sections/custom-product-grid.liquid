<section class="custom-product-grid">
  <div class="custom-product-grid__inner">
    <h2 class="custom-product-grid__heading">
      {{ section.settings.heading }}
    </h2>
  </div>
</section>

{% stylesheet %}

.custom-product-grid {
  width: 100%;
  padding: 60px 78px;
  background: #ffffff;
}

.custom-product-grid__inner {
  max-width: 1284px;
  margin: 0 auto;
}

.custom-product-grid__heading {
  margin: 0;
  font-size: 32px;
  line-height: 1.1;
  font-weight: 700;
  color: #000000;
}

{% endstylesheet %}

{% schema %}
{
  "name": "Custom Product Grid",
  "tag": "section",
  "class": "custom-product-grid-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    },
  ],
  "presets": [
    {
      "name": "Custom Product Grid"
    }
  ]
}
{% endschema %}