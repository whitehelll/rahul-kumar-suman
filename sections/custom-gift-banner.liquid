<section class="custom-gift-banner">
  <div class="custom-gift-banner__topbar">
    <div class="custom-gift-banner__brand">
      {{ section.settings.brand_text }}
    </div>

    <div class="custom-gift-banner__top-message">
      {{ section.settings.top_message }}
    </div>

    {% if section.settings.top_button_text != blank %}
      <a
        href="{{ section.settings.top_button_link }}"
        class="custom-gift-banner__top-button"
      >
        {{ section.settings.top_button_text }}
        <span aria-hidden="true">→</span>
      </a>
    {% endif %}
  </div>

  <div
    class="custom-gift-banner__hero"
    {% if section.settings.background_image != blank %}
      style="background-image: url('{{ section.settings.background_image | image_url: width: 2400 }}');"
    {% endif %}
  >
    <div class="custom-gift-banner__content">
      <h1>{{ section.settings.heading }}</h1>

      <div class="custom-gift-banner__description">
        {{ section.settings.description }}
      </div>

      {% if section.settings.button_text != blank %}
        <a
          href="{{ section.settings.button_link }}"
          class="custom-gift-banner__button"
        >
          {{ section.settings.button_text }}
          <span aria-hidden="true">→</span>
        </a>
      {% endif %}
    </div>
  </div>

  <div class="custom-gift-banner__bottom-message">
    {{ section.settings.bottom_message }}
  </div>
</section>

{% schema %}
{
  "name": "Custom Gift Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand text",
      "default": "TISSO VISION"
    },
    {
      "type": "text",
      "id": "top_message",
      "label": "Top message",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "top_button_text",
      "label": "Top button text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "top_button_link",
      "label": "Top button link"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Main button text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Main button link"
    },
    {
      "type": "text",
      "id": "bottom_message",
      "label": "Bottom message",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
  ],
  "presets": [
    {
      "name": "Custom Gift Banner"
    }
  ]
}
{% endschema %}